# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=traintogetheruser
POSTGRES_PASSWORD=secret
POSTGRES_DB=traintogetherdb

# MinIO Configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_PORT_UI=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=traintogether

# MinIO Docker environment variables (for docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: Set a custom from-email address (requires domain verification on Resend)
# Leave empty or comment out to use Resend's default: onboarding@resend.dev
# To use your own email: verify your domain at https://resend.com/domains first
# RESEND_FROM_EMAIL=donotreply@traintogether.com

# Optional: Set a custom support email address for contact links in rejection emails
# Leave empty or comment out to disable button in rejection emails
# Note: Each Resend account has a unique default address (e.g., <anything>@example.resend.dev)
RESEND_SUPPORT_EMAIL=

# Application URL (used in email links)
# Development: http://localhost:8080
# Production: https://yourdomain.com
APP_URL=http://localhost:8080
