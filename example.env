# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=traintogetheruser
POSTGRES_PASSWORD=secret
POSTGRES_DB=traintogetherdb

# MinIO Configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_PORT_UI=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=traintogether

# MinIO Docker environment variables (for docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Gmail Email Configuration
# IMPORTANT: Use an App Password, not your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
# (You may need to enable 2-Step Verification first)
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-16-character-app-password

# Application URL (used in email links)
# Development: http://localhost:8080
# Production: https://yourdomain.com
APP_URL=http://localhost:8080


# JWT configuration
JWT_SECRET=change-me-please-this-should-be-very-long-and-random
JWT_EXPIRATION_MS=3600000

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Google Places API (LEGACY) Key NOT Google Places New Api
GOOGLE_PLACES_API_KEY=your-google-api-key